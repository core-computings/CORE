#version 450

layout(constant_id = 7) const int kValue = -3;
layout(constant_id = 11) const float kScale = 1.5;
layout(constant_id = 13) const bool kEnabled = false;
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1,
       local_size_x_id = 0, local_size_y_id = 1) in;
layout(std430, binding = 0) buffer Output { uint values[]; };

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        values[0] = uint(kValue);
        values[1] = floatBitsToUint(kScale);
        values[2] = kEnabled ? 1u : 0u;
        values[3] = gl_WorkGroupSize.x;
        values[4] = gl_WorkGroupSize.y;
    }
}
