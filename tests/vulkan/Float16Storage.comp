#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(push_constant) uniform PushConstants {
    uint count;
}
pc;

layout(std430, binding = 0) readonly buffer src_in { float16_t src[]; };
layout(std430, binding = 1) writeonly buffer dst_out { float16_t dst[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= pc.count) {
        return;
    }
    const float16_t value = src[index];
    dst[index] = value * value * float16_t(0.125) + value * float16_t(-0.5) + float16_t(0.75);
}
